public/overrides/js/datatables/

# Генерируется сервером при каждом старте (dg-light.js, buildSettingsDemoCache/
# buildLangCountsCache) — не источник, коммитить нечего, каждое окружение строит файлы само.
settings/demo-data.json
settings/lang-counts.json
settings/scripts.json
settings/translator-catalog.json

# Генерируется build-icons.js (npm run build-icons) из @fortawesome/fontawesome-free —
# та же логика, что и dg_db*.json выше: не источник, каждое окружение строит сам.
public/overrides/js/fontawesome-local.js

# Генерируется dg-light.js (buildScriptBundle) при каждом старте сервера — та же логика, что и
# settings/scripts.json выше: не источник, склейка settings.js+dg-text-router.js и
# randPlaceholder.js+home.js для меньшего числа HTTP-запросов на главной.
public/overrides/js/settings-bundle.js
public/overrides/js/home-bundle.js

# The offline Android/iOS app moved out of this repo to dhammagift/dg-app-full (its history was
# split out with `git subtree split`, and the pre-removal state of this repo is kept on the
# `mobbak` branch). What stays here is the DISTRIBUTION of its artifacts: siteroot/mobile-data and
# siteroot/mobile-apk — see CLAUDE.md, "Приложение (dg-app-full)".
#
# mobile/ itself is still ignored on purpose: on the prod machine the artifact directories it
# used to hold (mobile/dist/*.db, mobile/android/.../apk/debug/) were never tracked, so removing
# the app's SOURCE from git deliberately leaves them in place and the two symlinks above keep
# serving without any manual step.
mobile/
*.db
*.db-wal
*.db-shm

# design-sync (claude.ai/design) — staged converter scripts, generated bundle, machine state
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
# design-system build output (regenerated by `npm run build` in design-system/)
design-system/dist/

# Офлайн-PWA (docs/OFFLINE_PWA_PLAN.md): генерируется build-offline.js (`npm run build-offline`).
# vendor/sqlite-wasm копируется из node_modules (@sqlite.org/sqlite-wasm), core-bundle.js
# собирается из core/search-core.js, build-id.json — хеш офлайн-слоя, которым service worker
# версионирует свой кеш оболочки. Тот же принцип, что у dg_db_light.json и fontawesome-local.js:
# не источник, каждое окружение строит сам.
public/offline/core-bundle.js
public/offline/build-id.json
public/offline/vendor/
# npm-кеш, который ставят внутрь репо, когда ~/.npm недоступен (dev-машины в песочнице).
.npm-cache/
# Локальная сборка офлайн-базы (dg-app-full/build-app-db.js) для test/offline-e2e.js: ~170 МБ,
# пересобирается из dg.db, в git не место.
.offline-test/
