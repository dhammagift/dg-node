{
  "name": "@dhammagift/dg-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Dhamma.gift design system — React components that emit the exact DOM the dhamma.gift search/reader app ships, styled by its own CSS.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./styles.css": "./dist/dg-ui.css"
  },
  "files": ["dist"],
  "scripts": {
    "gen:icons": "node scripts/gen-icons.mjs",
    "build:css": "node scripts/build-css.mjs",
    "build:js": "node scripts/build-js.mjs",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "npm run gen:icons && npm run build:css && npm run build:types && npm run build:js"
  },
  "peerDependencies": { "react": ">=18", "react-dom": ">=18" },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.24.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
