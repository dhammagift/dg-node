{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "selectAction": {
    "type": "Action.Execute",
    "verb": "open-day",
    "title": "Day & night"
  },
  "body": [
    {
      "type": "Container",
      "$when": "${$host.widgetSize == 'small'}",
      "items": [
        {
          "type": "Image",
          "url": "${img.small_dark}",
          "size": "Stretch",
          "altText": "${n.until}",
          "$when": "${$host.hostTheme == 'dark'}"
        },
        {
          "type": "Image",
          "url": "${img.small_light}",
          "size": "Stretch",
          "altText": "${n.until}",
          "$when": "${$host.hostTheme != 'dark'}"
        }
      ]
    },
    {
      "type": "Container",
      "$when": "${$host.widgetSize == 'medium'}",
      "items": [
        {
          "type": "Image",
          "url": "${img.medium_dark}",
          "size": "Stretch",
          "altText": "${n.until}",
          "$when": "${$host.hostTheme == 'dark'}"
        },
        {
          "type": "Image",
          "url": "${img.medium_light}",
          "size": "Stretch",
          "altText": "${n.until}",
          "$when": "${$host.hostTheme != 'dark'}"
        }
      ]
    },
    {
      "type": "Container",
      "$when": "${$host.widgetSize == 'large'}",
      "items": [
        {
          "type": "Image",
          "url": "${img.large_dark}",
          "size": "Stretch",
          "altText": "${n.until}",
          "$when": "${$host.hostTheme == 'dark'}"
        },
        {
          "type": "Image",
          "url": "${img.large_light}",
          "size": "Stretch",
          "altText": "${n.until}",
          "$when": "${$host.hostTheme != 'dark'}"
        }
      ]
    }
  ]
}