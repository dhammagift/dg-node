    "/api/tts/memo": {
      "servers": [
        {
          "url": "https://api.dhamma.gift",
          "description": "api.dhamma.gift"
        }
      ],
      "post": {
        "tags": [
          "tts"
        ],
        "summary": "Текст целиком одним MP3 с паузами (Memo)",
        "description": "Строки читаются подряд с паузами любой длины. Речь — до 30 минут (паузы не считаются), вся запись с паузами — до 180 минут; до 200 строк и 20 000 символов. Считается как 10 запросов в лимите.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "segments"
                ],
                "properties": {
                  "segments": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 200,
                    "description": "Строки, всего до 20 000 символов",
                    "example": [
                      "Evaṁ me sutaṁ.",
                      "Ekaṁ samayaṁ bhagavā…"
                    ]
                  },
                  "voice": {
                    "type": "string",
                    "default": "pratham"
                  },
                  "rate": {
                    "type": "number",
                    "default": 1
                  },
                  "delay": {
                    "type": "number",
                    "maximum": 3600,
                    "description": "Пауза между строками, секунды",
                    "example": 2
                  },
                  "end_delay": {
                    "type": "number",
                    "maximum": 3600,
                    "description": "Пауза в конце, секунды",
                    "example": 0
                  },
                  "sound": {
                    "type": "string",
                    "enum": [
                      "",
                      "gong.mp3",
                      "tick.mp3"
                    ],
                    "description": "Звук в конце"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "MP3",
            "content": {
              "audio/mpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Неизвестный голос или пустой текст",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "413": {
            "description": "Превышен лимит: паузы, число строк/символов или длина записи",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Превышен лимит запросов"
          }
        }
      }
    },
