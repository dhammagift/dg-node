    "/mcp": {
      "servers": [
        {
          "url": "https://api.dhamma.gift",
          "description": "api.dhamma.gift"
        }
      ],
      "post": {
        "tags": [
          "mcp"
        ],
        "summary": "MCP-сервер для ИИ-агентов (JSON-RPC, Streamable HTTP)",
        "description": "Инструменты: search, get_text, compare_translations, list_structure. По умолчанию только пали; переводы — langs или translators. Подключение в Claude: Settings → Connectors → https://api.dhamma.gift/mcp. Нужен заголовок Accept: application/json, text/event-stream.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              },
              "examples": {
                "tools/list": {
                  "value": {
                    "jsonrpc": "2.0",
                    "id": 1,
                    "method": "tools/list",
                    "params": {}
                  }
                },
                "get_text": {
                  "value": {
                    "jsonrpc": "2.0",
                    "id": 2,
                    "method": "tools/call",
                    "params": {
                      "name": "get_text",
                      "arguments": {
                        "suttaId": "sn56.11",
                        "langs": [
                          "ru"
                        ]
                      }
                    }
                  }
                },
                "search": {
                  "value": {
                    "jsonrpc": "2.0",
                    "id": 3,
                    "method": "tools/call",
                    "params": {
                      "name": "search",
                      "arguments": {
                        "query": "kata.*dukkh",
                        "include_segments": true
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON-RPC ответ (text/event-stream: строки «data: {...}»)"
          }
        }
      }
    },
    "/uposatha.ics": {
      "get": {
        "tags": [
          "uposatha"
        ],
        "summary": "Подписка на календарь упосатх (iCalendar для Google/Apple)",
        "description": "Без хранения: всё, что нужно ленте, — в адресе. Дни на 400 дней вперёд, напоминания; лента пересчитывается раз в час.",
        "parameters": [
          {
            "name": "tz",
            "in": "query",
            "required": false,
            "description": "Часовой пояс IANA",
            "schema": {
              "type": "string"
            },
            "example": "Europe/Moscow"
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "description": "Язык событий",
            "schema": {
              "type": "string",
              "enum": [
                "en",
                "ru"
              ]
            },
            "example": "ru"
          },
          {
            "name": "lat",
            "in": "query",
            "required": false,
            "description": "Широта (для рассвета и восхода луны)",
            "schema": {
              "type": "number"
            },
            "example": 55.75
          },
          {
            "name": "lon",
            "in": "query",
            "required": false,
            "description": "Долгота",
            "schema": {
              "type": "number"
            },
            "example": 37.62
          },
          {
            "name": "scheme",
            "in": "query",
            "required": false,
            "description": "sutta — по суттам (по умолчанию), modern — современный календарь",
            "schema": {
              "type": "string",
              "enum": [
                "sutta",
                "modern"
              ]
            }
          },
          {
            "name": "lead",
            "in": "query",
            "required": false,
            "description": "За сколько часов напоминать (0–72, по умолчанию 24)",
            "schema": {
              "type": "integer"
            },
            "example": 24
          },
          {
            "name": "d8",
            "in": "query",
            "required": false,
            "description": "Дни 8-й луны: 0 — не включать",
            "schema": {
              "type": "string",
              "enum": [
                "0",
                "1"
              ]
            }
          },
          {
            "name": "d14",
            "in": "query",
            "required": false,
            "description": "Дни 14-й луны: 0 — не включать",
            "schema": {
              "type": "string",
              "enum": [
                "0",
                "1"
              ]
            }
          },
          {
            "name": "d15",
            "in": "query",
            "required": false,
            "description": "Дни 15-й луны: 1 — включать",
            "schema": {
              "type": "string",
              "enum": [
                "0",
                "1"
              ]
            }
          },
          {
            "name": "day",
            "in": "query",
            "required": false,
            "description": "Второе напоминание в сам день, ЧЧММ",
            "schema": {
              "type": "string"
            },
            "example": "0600"
          },
          {
            "name": "adv",
            "in": "query",
            "required": false,
            "description": "С day=: 0 — без напоминания заранее",
            "schema": {
              "type": "string",
              "enum": [
                "0",
                "1"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "iCalendar",
            "content": {
              "text/calendar": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Неверный часовой пояс"
          }
        }
      }
    },
