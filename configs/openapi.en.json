{
  "openapi": "3.0.3",
  "info": {
    "title": "Dhamma.gift search API",
    "version": "1.0.0",
    "description": "Search over the Pali Canon (Sutta/Vinaya) — API for dg-light.js. All responses are JSON."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current server"
    }
  ],
  "tags": [
    {
      "name": "search",
      "description": "Keyword search"
    },
    {
      "name": "text",
      "description": "Full sutta text for the reader"
    },
    {
      "name": "toc",
      "description": "Table of contents and text structure"
    },
    {
      "name": "tts",
      "description": "Text to speech (Voice API) — api.dhamma.gift"
    },
    {
      "name": "mcp",
      "description": "MCP server for AI agents"
    }
  ],
  "components": {
    "parameters": {
      "scope": {
        "name": "scope",
        "in": "query",
        "description": "Search scope. Composite scopes: `default` (or omit the parameter) — the 4 Nikāyas + 6 KN books, no Vinaya/Abhidhamma. `all` — the whole corpus. Category scopes (each matches a whole top-level division): `dhamma` — the 4 Nikāyas only (Dīgha, Majjhima, Saṁyutta, Aṅguttara). `khudakka` — the whole Khuddaka Nikāya (all its books, not just the 6 in `default`). `vinaya` — the whole Vinaya Piṭaka. `abhi` — the Abhidhamma. You can also list specific book/collection ids separated by commas, mixed with category names (e.g. `dn,mn` or `dhamma,vinaya`) — ids include `dn`, `mn`, `sn`, `an` (4 Nikāyas); `ud`, `snp`, `dhp`, `thag`, `thig`, `iti`, `ja`, `tha-ap`, `thi-ap`, `mil`, `vv`, `pv`, `cp`, `bv`, `ps`, `ne`, `cnd`, `mnd`, `kp`, `pe` (Khuddaka Nikāya); `pli-tv-bi`, `pli-tv-bu`, `pli-tv-kd`, `pli-tv-pvr` (Vinaya).",
        "schema": {
          "type": "string",
          "default": "default",
          "example": "dhamma"
        }
      },
      "exact": {
        "name": "exact",
        "in": "query",
        "description": "Whole-word exact match (grep -w) instead of a substring match.",
        "schema": {
          "type": "boolean",
          "default": false
        }
      },
      "langs": {
        "name": "langs",
        "in": "query",
        "description": "Translation languages, comma-separated. `all` — every available language.",
        "schema": {
          "type": "string",
          "default": "ru,en",
          "example": "ru,en"
        }
      },
      "lb": {
        "name": "lb",
        "in": "query",
        "description": "Number of context lines BEFORE the matched segment (Pali root text).",
        "schema": {
          "type": "integer",
          "default": 0,
          "minimum": 0
        }
      },
      "la": {
        "name": "la",
        "in": "query",
        "description": "Number of context lines AFTER the matched segment (Pali root text).",
        "schema": {
          "type": "integer",
          "default": 0,
          "minimum": 0
        }
      }
    },
    "schemas": {
      "SearchMetadata": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "langs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lb": {
            "type": "integer"
          },
          "la": {
            "type": "integer"
          },
          "exactMatch": {
            "type": "boolean"
          },
          "totalFiles": {
            "type": "integer",
            "description": "Number of suttas found"
          },
          "totalMatches": {
            "type": "integer",
            "description": "Total number of matches"
          },
          "hasVariantMatch": {
            "type": "boolean",
            "description": "Whether variant readings exist for this word anywhere in the corpus (not only within the current scope)"
          },
          "partial": {
            "type": "boolean",
            "description": "true — this is a `?fast=1` response, root text/translations for some segments haven't loaded yet (see /search/enrich)"
          },
          "tooShort": {
            "type": "boolean",
            "description": "true — the keyword is shorter than the minimum length (3 characters), no search was performed"
          }
        }
      },
      "Segment": {
        "type": "object",
        "properties": {
          "segment": {
            "type": "string",
            "example": "dn1:1.1"
          },
          "root_text": {
            "type": "string",
            "description": "Pali root reading"
          },
          "variant": {
            "type": "string",
            "description": "Pali variant reading (if any)"
          },
          "translations": {
            "type": "object",
            "description": "Key like \"ru_khantibalo\", \"en_sujato\" -> translation text",
            "additionalProperties": {
              "type": "string"
            }
          },
          "html": {
            "type": "string"
          },
          "lb_context": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "la_context": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "SuttaResult": {
        "type": "object",
        "properties": {
          "sutta_id": {
            "type": "string",
            "example": "dn1"
          },
          "category": {
            "type": "string",
            "enum": [
              "dhamma",
              "khudakka",
              "vinaya",
              "abhi",
              "other"
            ]
          },
          "dir_path": {
            "type": "string"
          },
          "titles": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "mr": {
            "type": "integer",
            "description": "Edition/relevance rank (mtph from textinfo)"
          },
          "count": {
            "type": "integer",
            "description": "Number of matches in this sutta"
          },
          "unique_words": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "segments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Segment"
            }
          }
        }
      },
      "WordReportEntry": {
        "type": "object",
        "properties": {
          "word": {
            "type": "string"
          },
          "textCount": {
            "type": "integer"
          },
          "matchCount": {
            "type": "integer"
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sutta_id": {
                  "type": "string"
                },
                "segment": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "VariantSegment": {
        "type": "object",
        "description": "A segment where the keyword occurs in the variant (non-root) reading — text is taken from the variant file as-is, including SuttaCentral's editorial notation (\"→\", \"(mr)\", \"(?)\").",
        "properties": {
          "sutta_id": {
            "type": "string"
          },
          "segment": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "example": "Macchakacchapasañchannā → macchakacchapasampannā (?) "
          }
        }
      },
      "SearchResponse": {
        "type": "object",
        "properties": {
          "metadata": {
            "$ref": "#/components/schemas/SearchMetadata"
          },
          "data": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/SuttaResult"
            }
          },
          "wordReport": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WordReportEntry"
            }
          },
          "variantSegments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VariantSegment"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/search": {
      "get": {
        "tags": [
          "search"
        ],
        "summary": "Search by keyword",
        "description": "Without `?fast=1` — full response (root text/translations for all matched segments, wordReport, variantSegments). With `?fast=1` — a fast partial response (skeleton + wordReport + variantSegments only, no sutta file reads) — used for an instant first render; full data is then loaded via /search/enrich.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search word/phrase. Minimum 3 characters — shorter is ignored (see `tooShort` in the response).",
            "schema": {
              "type": "string"
            },
            "example": "kacchapa"
          },
          {
            "$ref": "#/components/parameters/scope"
          },
          {
            "$ref": "#/components/parameters/exact"
          },
          {
            "$ref": "#/components/parameters/langs"
          },
          {
            "$ref": "#/components/parameters/lb"
          },
          {
            "$ref": "#/components/parameters/la"
          },
          {
            "name": "fast",
            "in": "query",
            "description": "`1` — fast partial response without reading sutta files (see description above).",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "q was not provided",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/search/{keyword}": {
      "get": {
        "tags": [
          "search"
        ],
        "summary": "Same as /search?q={keyword} — keyword as part of the path",
        "description": "Short links: /search/kacchapa?scope=dhamma works the same as /search?q=kacchapa&scope=dhamma. The remaining parameters are the same query parameters as /search.",
        "parameters": [
          {
            "name": "keyword",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "kacchapa"
          },
          {
            "$ref": "#/components/parameters/scope"
          },
          {
            "$ref": "#/components/parameters/exact"
          },
          {
            "$ref": "#/components/parameters/langs"
          },
          {
            "$ref": "#/components/parameters/lb"
          },
          {
            "$ref": "#/components/parameters/la"
          },
          {
            "name": "fast",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/search/enrich": {
      "get": {
        "tags": [
          "search"
        ],
        "summary": "Load full data (root text/translations) for specific sutta ids",
        "description": "Called after /search?fast=1 with the sutta ids that need to be \"enriched\" — e.g. the currently visible table page, or all found ids at once. keyword/scope must match the original /search?fast=1 call (otherwise it is recomputed from scratch, without reusing the cache).",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "kacchapa"
          },
          {
            "name": "ids",
            "in": "query",
            "required": true,
            "description": "Comma-separated sutta ids.",
            "schema": {
              "type": "string"
            },
            "example": "dn1,dn2,sn35.240"
          },
          {
            "$ref": "#/components/parameters/scope"
          },
          {
            "$ref": "#/components/parameters/exact"
          },
          {
            "$ref": "#/components/parameters/langs"
          },
          {
            "$ref": "#/components/parameters/lb"
          },
          {
            "$ref": "#/components/parameters/la"
          }
        ],
        "responses": {
          "200": {
            "description": "Data for the requested ids (same shape as data[id] in /search) plus up-to-date wordReport/metadata/variantSegments",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "q or ids was not provided",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/text/{suttaId}": {
      "get": {
        "tags": [
          "text"
        ],
        "summary": "Full sutta text (all segments, not just matches) — for the reader",
        "parameters": [
          {
            "name": "suttaId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "dn22"
          },
          {
            "$ref": "#/components/parameters/langs"
          },
          {
            "name": "translators",
            "in": "query",
            "description": "Explicit comma-separated list of translators (e.g. `ru_o,ru_sv`) — two translations of the SAME language at once, bypassing the usual \"one translator per language\" selection.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Full sutta text",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sutta_id": {
                      "type": "string"
                    },
                    "category": {
                      "type": "string"
                    },
                    "dir_path": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "mr": {
                      "type": "integer"
                    },
                    "segments": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Segment"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Unknown sutta id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/nav/{suttaId}": {
      "get": {
        "tags": [
          "text"
        ],
        "summary": "Previous/next sutta for reader navigation",
        "parameters": [
          {
            "name": "suttaId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "dn22"
          }
        ],
        "responses": {
          "200": {
            "description": "Neighboring suttas in skeletonDB order",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "prev": {
                      "type": "object",
                      "nullable": true,
                      "properties": {
                        "slug": {
                          "type": "string"
                        },
                        "title": {
                          "type": "string"
                        }
                      }
                    },
                    "next": {
                      "type": "object",
                      "nullable": true,
                      "properties": {
                        "slug": {
                          "type": "string"
                        },
                        "title": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Unknown sutta id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/toc": {
      "get": {
        "tags": [
          "toc"
        ],
        "summary": "Category/book tree of the table of contents (Sutta/Vinaya and their sections)",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "categories": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/toc/book/{code}": {
      "get": {
        "tags": [
          "toc"
        ],
        "summary": "Full tree of a single book, optionally with per-language translators",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "dn"
          },
          {
            "name": "langs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated language codes to include translator availability for",
            "example": "ru,en"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "tree": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "translations": {
                      "type": "object"
                    },
                    "interlinearKeys": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Unknown book code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/transliterate": {
      "get": {
        "tags": [
          "text"
        ],
        "summary": "Transliterate the given text to IAST (Latin with diacritics)",
        "parameters": [
          {
            "name": "text",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "kamma"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "converted": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/patimokkha-fragment/{side}": {
      "get": {
        "tags": [
          "text"
        ],
        "summary": "HTML fragment of the Patimokkha (bu — bhikkhu, bi — bhikkhuni) for edition comparison",
        "parameters": [
          {
            "name": "side",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "bu",
                "bi"
              ]
            },
            "example": "bu"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Invalid side"
          }
        }
      }
    },
    "/api/tts/pali": {
      "servers": [
        {
          "url": "https://api.dhamma.gift",
          "description": "api.dhamma.gift"
        }
      ],
      "post": {
        "tags": [
          "tts"
        ],
        "summary": "Read a phrase aloud (base64 MP3)",
        "description": "Open text-to-speech service, no key, open CORS, 60 requests per minute per IP. The answer has the shape of Google Text-to-Speech.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "maxLength": 2000,
                    "description": "Text: Pāḷi in IAST, or an English/Russian translation",
                    "example": "Evaṁ me sutaṁ."
                  },
                  "voice": {
                    "type": "string",
                    "default": "pratham",
                    "description": "Voice; the list is GET /api/tts/dg-voices",
                    "example": "pratham"
                  },
                  "rate": {
                    "type": "number",
                    "minimum": 0.25,
                    "maximum": 3,
                    "default": 1,
                    "description": "Speed; the site reads Pāḷi at 0.875",
                    "example": 0.875
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "audioContent": {
                      "type": "string",
                      "description": "base64 MP3, mono, 22 kHz"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/api/tts/memo": {
      "servers": [
        {
          "url": "https://api.dhamma.gift",
          "description": "api.dhamma.gift"
        }
      ],
      "post": {
        "tags": [
          "tts"
        ],
        "summary": "A whole text as one MP3 with pauses (Memo)",
        "description": "Lines are read one after another with pauses of any length; up to 45 minutes. Counts as ten requests against the limit.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "segments"
                ],
                "properties": {
                  "segments": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 200,
                    "description": "Lines, up to 20 000 characters in all",
                    "example": [
                      "Evaṁ me sutaṁ.",
                      "Ekaṁ samayaṁ bhagavā…"
                    ]
                  },
                  "voice": {
                    "type": "string",
                    "default": "pratham"
                  },
                  "rate": {
                    "type": "number",
                    "default": 1
                  },
                  "delay": {
                    "type": "number",
                    "maximum": 300,
                    "description": "Pause between lines, seconds",
                    "example": 2
                  },
                  "end_delay": {
                    "type": "number",
                    "maximum": 600,
                    "description": "Pause at the end, seconds",
                    "example": 0
                  },
                  "sound": {
                    "type": "string",
                    "enum": [
                      "",
                      "gong.mp3",
                      "tick.mp3"
                    ],
                    "description": "Sound at the end"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "MP3",
            "content": {
              "audio/mpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/api/tts/dg-voices": {
      "servers": [
        {
          "url": "https://api.dhamma.gift",
          "description": "api.dhamma.gift"
        }
      ],
      "get": {
        "tags": [
          "tts"
        ],
        "summary": "The list of voices",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
