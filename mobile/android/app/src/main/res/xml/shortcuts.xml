<?xml version="1.0" encoding="utf-8"?>
<!-- Static App Shortcuts (long-press the launcher icon). Ported from dg-twa's web manifest
     (app/src/main/res/raw/web_app_manifest.json "shortcuts") — a Capacitor WebView isn't a
     Trusted Web Activity, so the OS doesn't wire these up from a web manifest automatically;
     each one is a plain Android shortcut that launches MainActivity with a "route" extra
     (see MainActivity.handleIntent), which loads that path in the already-running SPA.

     All 4 slots used, matching the TWA lifehack of never leaving one idle — "Dict.Dhamma.gift"
     (online-only DPD dictionary) and "DG Read" (legacy /read.php, superseded by this app's own
     reader) from the original 4 were dropped as before (a shortcut into a page that doesn't work
     offline, or a route this app doesn't have, defeats the point of a fast offline entry point),
     but the freed slots go to TOC and Favorites/History instead of sitting unused:
     - "toc" replaces the old plain "/" shortcut, which just duplicated launching the app icon
       itself — TOC is a genuinely distinct entry point.
     - "Bhikkhu/Bhikkhuni Patimokkha" point at the TOC entries for those books
       (/toc/pli-tv-bu-pm, /toc/pli-tv-bi-pm) rather than the legacy /pm.php-rendered single page
       (reader/bu-pm.html) — that page's own logic wasn't ported into the offline shim, TOC
       already reaches the same content.
     - "favorites" has no route of its own (Favorites/History live inside the Quick Modal, not
       the SPA router) — MainActivity passes a boolean "openQuickModal" extra instead of "route",
       app.js opens the modal once it loads (see rewriteNativeShortcutRoute). tab-fav (Favorites+
       History combined) is already the modal's default tab, no tab-switch needed. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="toc"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_toc_short"
        android:shortcutLongLabel="@string/shortcut_toc_long">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="gift.dhamma.mobile"
            android:targetClass="gift.dhamma.mobile.MainActivity">
            <extra android:name="route" android:value="/toc" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="bhikkhu_patimokkha"
        android:enabled="true"
        android:icon="@drawable/shortcut_monk"
        android:shortcutShortLabel="@string/shortcut_bu_pm_short"
        android:shortcutLongLabel="@string/shortcut_bu_pm_long">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="gift.dhamma.mobile"
            android:targetClass="gift.dhamma.mobile.MainActivity">
            <extra android:name="route" android:value="/toc/pli-tv-bu-pm" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="bhikkhuni_patimokkha"
        android:enabled="true"
        android:icon="@drawable/shortcut_nun"
        android:shortcutShortLabel="@string/shortcut_bi_pm_short"
        android:shortcutLongLabel="@string/shortcut_bi_pm_long">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="gift.dhamma.mobile"
            android:targetClass="gift.dhamma.mobile.MainActivity">
            <extra android:name="route" android:value="/toc/pli-tv-bi-pm" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="favorites"
        android:enabled="true"
        android:icon="@drawable/shortcut_favorites"
        android:shortcutShortLabel="@string/shortcut_favorites_short"
        android:shortcutLongLabel="@string/shortcut_favorites_long">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="gift.dhamma.mobile"
            android:targetClass="gift.dhamma.mobile.MainActivity">
            <extra android:name="openQuickModal" android:value="true" />
        </intent>
    </shortcut>
</shortcuts>
